# ---------------------------------------------------------------------------
# U-Mole configuration. Copy to .env and fill in. NEVER commit .env.
# Generate a fresh SECRET_KEY with:  node scripts/gen-secret.js
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Public origin of the site. Used for absolute links (invites) and for
# Origin/Referer checking on state-changing requests. Must match exactly,
# including scheme and port.
APP_URL=https://example.com

# 64 hex chars. Used as the Argon2id pepper for password hashes and as the
# HMAC key for invite/reset/session tokens stored in the database.
# WARNING: changing or losing this invalidates every password and token.
SECRET_KEY=

# Where the SQLite database lives.
DATABASE_PATH=./data/umole.sqlite3

# Set to 1 when running behind exactly one reverse proxy (nginx, Caddy,
# Cloudflare) that sets X-Forwarded-For / X-Forwarded-Proto. Leave at 0 when
# the app is exposed directly, otherwise clients can spoof their IP.
TRUST_PROXY=0

# Session lifetimes.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# How long a re-authentication ("sudo") lasts before sensitive admin actions
# ask for the password again.
SUDO_TIMEOUT_MINUTES=15

# Label shown in authenticator apps.
TOTP_ISSUER=U-Mole

# Hours an invite or password-reset link stays valid.
INVITE_TTL_HOURS=48

# Argon2id cost. The defaults (64 MiB, 3 passes) are a good starting point;
# raise memory until hashing takes roughly half a second on your server.
# PASSWORD_MEMORY_COST_KIB=65536
# PASSWORD_TIME_COST=3
# PASSWORD_PARALLELISM=1

# Read the client address from this single header instead of the socket.
# Set to `cf-connecting-ip` when running behind a Cloudflare Tunnel: only
# Cloudflare can set that header, and a tunnelled deployment publishes no
# port, so nothing can bypass it. Leave EMPTY if the app is reachable
# directly — otherwise anyone can forge their address and slip past the
# rate limits and the account lockout. See DEPLOYMENT.md.
CLIENT_IP_HEADER=
